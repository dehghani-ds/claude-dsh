# systemd user service for Claude Workbench — a template.
# Don't copy it by hand: run ./install-service.sh, which fills in the @…@ values for your machine.
#   Logs:  journalctl --user -u workbench -f
[Unit]
Description=Claude Workbench (http://127.0.0.1:@PORT@/)
# With a desktop, start after it so DISPLAY/WAYLAND_DISPLAY exist for the "open terminal" buttons
After=@TARGET@
PartOf=@TARGET@

[Service]
ExecStart="@PYTHON@" "@DIR@/server.py" --port @PORT@
WorkingDirectory=@DIR@
# claude, git and bash must be findable: the installer copies the PATH of the shell it ran in
Environment="PATH=@PATH@"
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=@TARGET@
